{
    "name": "yourname/laravel-tmdb",
    "description": "A lightweight TMDB API wrapper using Laravel's HTTP Client",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "YourName\\Tmdb\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YourName\\Tmdb\\TmdbServiceProvider"
            ],
            "aliases": {
                "Tmdb": "YourName\\Tmdb\\Facades\\Tmdb"
            }
        }
    }
}